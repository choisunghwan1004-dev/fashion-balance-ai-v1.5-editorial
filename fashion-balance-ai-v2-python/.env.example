DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=fashion_balance
PORT=3000

# 선택 사항: 사진 AI 분석을 사용하려면 설정
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini

# V1.9: Use a phone-reachable URL. Production requires HTTPS.
APP_BASE_URL=http://localhost:3000
NODE_ENV=development
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
ADMIN_EMAILS=

# Docker only: set a different strong root password before docker compose up.
MYSQL_ROOT_PASSWORD=
